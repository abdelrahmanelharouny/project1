# Documentation template ONLY. Never commit a completed copy or use placeholders live.
# NEXT.JS / VERCEL: build and runtime, server-only. No NEXT_PUBLIC_* secrets.
CROPTWIST_API_ORIGIN=https://REPLACE-api-host.example

# FASTAPI / WORKER HOST: copy session pooler connection from Supabase Connect.
# Percent-encode reserved password characters. App role, not postgres admin.
CROPTWIST_ENVIRONMENT=staging
CROPTWIST_DEV_MODE=false
CROPTWIST_DATABASE_URL=postgresql+psycopg2://croptwist_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
CROPTWIST_DATABASE_SSLMODE=verify-full
CROPTWIST_DATABASE_SSLROOTCERT=/run/secrets/supabase-ca.crt
CROPTWIST_DATABASE_SEARCH_PATH=public,extensions
CROPTWIST_DATABASE_POOL_SIZE=2
CROPTWIST_DATABASE_MAX_OVERFLOW=0
CROPTWIST_DATABASE_POOL_TIMEOUT_SECONDS=10
CROPTWIST_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CROPTWIST_DATABASE_HEALTH_TIMEOUT_SECONDS=3
CROPTWIST_TRUSTED_HOSTS=REPLACE-api-host.example,localhost,127.0.0.1
CROPTWIST_CORS_ALLOW_ORIGINS=https://REPLACE-approved-preview.vercel.app
# Single API ownership only. 0 means synchronous ingestion, NOT offloaded workers.
CROPTWIST_JOB_WORKERS=1
CROPTWIST_SCHEDULER_ENABLED=true
CROPTWIST_PASSWORD_PBKDF2_ITERATIONS=600000
CROPTWIST_AUTH_RATE_LIMIT_PER_MINUTE=10
CROPTWIST_BILLING_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
CROPTWIST_RASTER_URL_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
# Existing durable host only: NOT Render's ephemeral filesystem.
CROPTWIST_RASTER_STORAGE_BACKEND=local
CROPTWIST_RASTER_STORAGE_ROOT=/srv/croptwist/rasters
CROPTWIST_REPORTS_DIR=/srv/croptwist/reports
# Optional provider secrets remain server-side; do not enable billable AI defaults.
CROPTWIST_CDSE_USERNAME=
CROPTWIST_CDSE_PASSWORD=
CROPTWIST_EARTHDATA_USERNAME=
CROPTWIST_EARTHDATA_PASSWORD=
CROPTWIST_EARTHDATA_BEARER_TOKEN=
# Supabase Auth/Storage are evaluated, not configured as active replacements.
# No Supabase service key is required for the PostgreSQL-only integration.
