# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# FieldShift local data & runtimes (dev-only artifacts, never commit)
/db/pgdata/
/db/pgenv/
/db/fieldshift-pgdata/
mini-services/fieldshift-api/.venv/
mini-services/fieldshift-api/__pycache__/
mini-services/fieldshift-api/.pytest_cache/
mini-services/fieldshift-api/dev.log
**/__pycache__/

# downloadable backup artifacts (served via /fieldshift-backup.zip)
public/*.zip

# conda/mamba package cache (env tooling, never commit)
/db/mamba-root/

# CropTwist sandbox DB dumps (backup cron, never commit)
/backups/

# P1 AI evaluation reports (generated artifacts, regenerable via scripts/run_evaluation.py)
mini-services/fieldshift-api/evaluation_reports/

# P3 runtime report artifacts (generated per report job)
mini-services/fieldshift-api/reports_storage/

# P05 runtime raster object store (local dev backend; regenerable, never commit)
raster_storage/

# P05 demo seed fixture rasters (generated by scripts/seed_fixture_processing_demo.py)
mini-services/fieldshift-api/db/demo_fixtures/

# session tooling scratch output (never commit)
tool-results/

# Isolated Next build outputs are generated, never source.
.next-*

# Required source SQL, not a generated local artifact.
!deployment/supabase/local-postgis.sql

# Generated integration snapshots and obsolete source archives
.initial_snapshot.json
download/*.zip
