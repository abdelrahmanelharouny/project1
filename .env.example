# Local Compose example only. Do not use these values in production.
# Production needs managed secrets, private ingress, managed PostgreSQL/PostGIS,
# persistent object storage, and a deployment-specific configuration review.

FIELDSHIFT_COMPOSE_PG_USER=postgres
FIELDSHIFT_COMPOSE_PG_PASSWORD=local-demo-change-me
FIELDSHIFT_COMPOSE_PG_DB=fieldshift
FIELDSHIFT_COMPOSE_PG_PORT=5433

# Secure default: dev/demo endpoints and auto-verified registration stay off.
# Set CROPTWIST_DEV_MODE=true only for an isolated local demonstration.
CROPTWIST_ENVIRONMENT=development
CROPTWIST_DEV_MODE=false
CROPTWIST_CORS_ALLOW_ORIGINS=
CROPTWIST_PASSWORD_PBKDF2_ITERATIONS=600000
CROPTWIST_AUTH_TOKEN_TTL_SECONDS=43200
CROPTWIST_AUTH_REFRESH_TTL_SECONDS=2592000
CROPTWIST_AUTH_RATE_LIMIT_PER_MINUTE=10
CROPTWIST_DEFAULT_PAGE_SIZE=50
CROPTWIST_MAX_PAGE_SIZE=500
CROPTWIST_MAX_IMPORT_FILE_BYTES=32000000
CROPTWIST_JOB_WORKERS=2
# Intentionally empty by default. Configure only through a secret manager;
# production startup also requires a real non-sandbox billing adapter.
CROPTWIST_BILLING_WEBHOOK_SECRET=
