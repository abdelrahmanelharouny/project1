# Local Compose example only. Do not use these values in production.
# Production needs managed secrets, private ingress, managed PostgreSQL/PostGIS,
# persistent object storage, and a deployment-specific configuration review.

FIELDSHIFT_COMPOSE_PG_USER=postgres
FIELDSHIFT_COMPOSE_PG_PASSWORD=local-demo-change-me
FIELDSHIFT_COMPOSE_PG_DB=fieldshift
FIELDSHIFT_COMPOSE_PG_PORT=5433

# Secure default: dev/demo endpoints and auto-verified registration stay off.
# Set CROPTWIST_DEV_MODE=true only for an isolated local demonstration.
CROPTWIST_ENVIRONMENT=development
CROPTWIST_DEV_MODE=false
CROPTWIST_CORS_ALLOW_ORIGINS=
CROPTWIST_PASSWORD_PBKDF2_ITERATIONS=600000
CROPTWIST_AUTH_TOKEN_TTL_SECONDS=43200
CROPTWIST_AUTH_REFRESH_TTL_SECONDS=2592000
CROPTWIST_AUTH_RATE_LIMIT_PER_MINUTE=10
CROPTWIST_DEFAULT_PAGE_SIZE=50
CROPTWIST_MAX_PAGE_SIZE=500
CROPTWIST_MAX_IMPORT_FILE_BYTES=32000000
CROPTWIST_JOB_WORKERS=2

# Provider preferences are exact, configurable identifiers, not a live-ready promise.
# Install keys only through the deployment secret manager.
CROPTWIST_LLM_ENABLED=true
CROPTWIST_GEMINI_API_KEY=
CROPTWIST_GEMINI_MODEL=gemini-3.6-flash
CROPTWIST_GROQ_API_KEY=
CROPTWIST_GROQ_MODEL=openai/gpt-oss-120b
CROPTWIST_OPENROUTER_API_KEY=
CROPTWIST_OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
CROPTWIST_LLM_PROVIDER_ORDER=gemini,groq,openrouter
CROPTWIST_AI_PROVIDER_TIMEOUT_SECONDS=25
CROPTWIST_AI_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
CROPTWIST_AI_PROVIDER_MAX_RETRIES=1
CROPTWIST_AI_PROVIDER_MAX_CONCURRENT=4
# Entire provider chain stays below the AI tool's 50-second hard deadline.
CROPTWIST_AI_PROVIDER_CHAIN_TIMEOUT_SECONDS=45
CROPTWIST_AI_PROVIDER_MAX_RESPONSE_BYTES=2000000
CROPTWIST_AI_PROVIDER_MAX_STREAM_FRAME_BYTES=262144
CROPTWIST_AI_PROVIDER_MAX_OUTPUT_CHARS=64000
# Both field-data gates default off until vendor data-handling terms are reviewed.
CROPTWIST_AI_ALLOW_FIELD_DATA_TO_PROVIDERS=false
# OpenRouter free-model field-data use requires this separate explicit approval.
CROPTWIST_OPENROUTER_ALLOW_FIELD_DATA=false
# Source documents and query text need separate embedding-vendor review.
CROPTWIST_AI_KNOWLEDGE_ALLOW_DOCUMENTS_TO_EMBEDDING_PROVIDER=false
CROPTWIST_AI_KNOWLEDGE_ALLOW_QUERIES_TO_EMBEDDING_PROVIDER=false

# Production email verification/reset/invitation challenge delivery.
# Without this adapter, production signup/reset requests fail closed with 503.
# Supply values via a deployment secret manager; TLS is mandatory.
FIELDSHIFT_EMAIL_SMTP_HOST=
FIELDSHIFT_EMAIL_SMTP_PORT=587
FIELDSHIFT_EMAIL_SMTP_FROM_ADDRESS=
FIELDSHIFT_EMAIL_SMTP_TLS_MODE=starttls
FIELDSHIFT_EMAIL_SMTP_TIMEOUT_SECONDS=10
FIELDSHIFT_EMAIL_SMTP_USERNAME=
FIELDSHIFT_EMAIL_SMTP_PASSWORD=

# Local billing simulation only; production requires a real adapter and secret.
CROPTWIST_BILLING_PROVIDER=sandbox
# Intentionally empty by default. Configure only through a secret manager.
CROPTWIST_BILLING_WEBHOOK_SECRET=
